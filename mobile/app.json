{
  "expo": {
    "name": "Vidklipral",
    "slug": "vidklipral",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vidklipral",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clippnow.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.clippnow.app",
      "adaptiveIcon": {
        "backgroundColor": "#111827"
      }
    },
    "plugins": [
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vidklipral needs access to your videos so you can create clips.",
          "cameraPermission": "Vidklipral needs camera access when you choose to record a clip.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Vidklipral to securely access your saved session."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.1.20"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ]
  }
}
